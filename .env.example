# TGHandyUtils — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# Secrets live ONLY here (a guard test enforces env-only secrets in config.py).

# ── Required ─────────────────────────────────────────────────────────────────
# Your Telegram bot token from @BotFather. Use a SEPARATE bot for dev vs prod.
TELEGRAM_BOT_TOKEN=

# OpenAI API key — used by default text roles in pure-API mode, quality/vision,
# whisper transcription, and the openai image provider.
OPENAI_API_KEY=

# ── Optional backends (leave empty to disable — missing values fail LOUDLY only
#    when a role/provider is actually routed to them) ────────────────────────
# claude -p console backend (anki role model 'claude-p'): run `claude setup-token`
# on any machine with a Claude subscription, complete the browser approval, paste
# the sk-ant-oat... token here.
CLAUDE_CODE_OAUTH_TOKEN=

# ChatGPT-browser image/text service (anki_image_provider 'chatgpt' / model
# 'chatgpt-web'). This is a self-hosted private service — see
# docs/infrastructure.md. Without your own instance, use PURE-API MODE below.
CHATGPT_BROWSER_API_URL=
CHATGPT_BROWSER_API_TOKEN=

# Gemini image provider (anki_image_provider 'gemini')
GEMINI_API_KEY=

# ElevenLabs voice generation for language cards
ELEVENLABS_API_KEY=

# Task platforms (optional integrations)
TODOIST_API_TOKEN=
TRELLO_API_KEY=
TRELLO_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── PURE-API MODE (recommended for a fresh deployment) ───────────────────────
# The committed config/anki.profile.yaml routes anki roles to private backends
# (claude-p text + chatgpt-browser images). Env vars override the yaml — uncomment
# this block to run everything on the OpenAI API with just OPENAI_API_KEY:
#ANKI_DECISION_MODEL=gpt-5.4
#ANKI_SCENARIO_MODEL=gpt-5.4
#ANKI_RENDER_MODEL=gpt-5.4-mini
#ANKI_QUALITY_MODEL=gpt-5.4-mini
#ANKI_IMAGE_PROVIDER=openai

# ── Optional tuning ──────────────────────────────────────────────────────────
#LOG_LEVEL=INFO
#DATABASE_PATH=data/db/tasks.db
