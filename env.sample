# Required secrets
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key

# Optional provider secrets
# GEMINI_API_KEY=your_gemini_api_key
# ELEVENLABS_API_KEY=your_elevenlabs_api_key
# TODOIST_API_TOKEN=your_todoist_api_token
# TRELLO_API_KEY=your_trello_api_key
# TRELLO_TOKEN=your_trello_token
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Deployment/runtime paths and logging
# DATABASE_PATH=data/db/tasks.db
# LOG_LEVEL=DEBUG
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# LOG_FILE=data/logs/bot.log

# Optional OpenAI prompt-cache routing hints
# OPENAI_PROMPT_CACHE_KEY_PREFIX=tghandyutils
# OPENAI_PROMPT_CACHE_RETENTION=

# Non-secret defaults live in config/workflow.yaml and config/anki.profile.yaml.
# Use env only for deployment overrides. Generic override examples:
# WORKFLOW_MAX_TEXT_CALLS_PER_RUN=16
# WORKFLOW_MAX_IMAGE_CALLS_PER_RUN=1
# WORKFLOW_MAX_ESTIMATED_USD_PER_RUN=5
# WORKFLOW_SETTING_DEFAULT_TASK_PLATFORM=todoist

# Product transition overrides are still accepted at the app edge:
# ANKI_CARD_MODEL=gpt-5.4-mini
# ANKI_IMAGE_PROVIDER=openai
# ANKI_IMAGE_PROVIDER=gemini
# ANKI_IMAGE_PROVIDER=comparison
# ANKI_IMAGE_COMPARE_PROVIDERS=openai,gemini
# ANKI_STYLE_CHARACTER_REFERENCE_IMAGE=assets/anki/ppla-character-reference-v3.png
# ANKI_STYLE_DESIGN_REFERENCE_IMAGE=assets/anki/ppla-style-reference-v3.png
# ANKI_ELEVENLABS_VOICE_ID=bBNhdwrIjl4fcVYiRbT2
