# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key

# Optional: Default platform configuration
# If specified, new users will use this platform by default
# Valid values: todoist, trello
DEFAULT_TASK_PLATFORM=todoist

# Optional - enable platforms you use

# For Todoist integration
#TODOIST_API_TOKEN=your_todoist_api_token

# For Trello integration
# Get your API key from https://trello.com/app-key
#TRELLO_API_KEY=your_trello_api_key
#TRELLO_TOKEN=your_trello_token

# For Google Calendar integration
#GOOGLE_CLIENT_ID=your_google_client_id
#GOOGLE_CLIENT_SECRET=your_google_client_secret

# Testing configuration
# Allow users to send auth requests to themselves (useful for testing)
#ALLOW_SELF_AUTH_REQUESTS=true