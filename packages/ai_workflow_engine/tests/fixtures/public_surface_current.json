    "CapabilityContext": {
      "$defs": {
        "CriticismEnvelope": {
          "description": "Evaluator criticism used for repair/retry/retrace prompts.",
          "properties": {
            "expected": {
              "title": "Expected",
              "type": "string"
            },
            "observed": {
              "title": "Observed",
              "type": "string"
            },
            "severity": {
              "default": "medium",
              "enum": [
                "low",
                "medium",
                "high",
                "blocking"
              ],
              "title": "Severity",
              "type": "string"
            },
            "target_capability": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Target Capability"
            },
            "user_visible_effect": {
              "default": "",
              "title": "User Visible Effect",
              "type": "string"
            }
          },
          "required": [
            "observed",
            "expected"
          ],
          "title": "CriticismEnvelope",
          "type": "object"
        },
        "ExecutionWindowDecision": {
          "additionalProperties": false,
          "description": "The one resolved, serializable time-limit decision for an invocation.\n\n``hard_timeout_s`` is the outer cutoff; ``soft_timeout_s`` = hard minus the completion\nreserve (the work deadline that leaves room for salvage/cleanup). ``None`` hard means no\nbound applied \u2014 an unbounded invocation. ``limiting_sources``/``clamps`` name exactly why\nthe hard limit is what it is; ``enforcement`` is how it will be enforced.",
          "properties": {
            "capability_timeout_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Capability Timeout S"
            },
            "clamps": {
              "items": {
                "enum": [
                  "capability",
                  "run_remaining",
                  "parent_soft_remaining"
                ],
                "type": "string"
              },
              "title": "Clamps",
              "type": "array"
            },
            "completion_reserve_s": {
              "default": 0.0,
              "title": "Completion Reserve S",
              "type": "number"
            },
            "enforcement": {
              "default": "none",
              "enum": [
                "process",
                "cooperative",
                "none"
              ],
              "title": "Enforcement",
              "type": "string"
            },
            "hard_timeout_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Hard Timeout S"
            },
            "limiting_sources": {
              "items": {
                "enum": [
                  "task_request",
                  "capability_limit",
                  "run_limit",
                  "parent_window"
                ],
                "type": "string"
              },
              "title": "Limiting Sources",
              "type": "array"
            },
            "parent_remaining_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Parent Remaining S"
            },
            "request_source": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Request Source"
            },
            "requested_timeout_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Requested Timeout S"
            },
            "run_remaining_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Run Remaining S"
            },
            "soft_timeout_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Soft Timeout S"
            }
          },
          "title": "ExecutionWindowDecision",
          "type": "object"
        },
        "ModelProfile": {
          "description": "Provider/model selection for a capability or node.",
          "properties": {
            "max_retries": {
              "default": 1,
              "title": "Max Retries",
              "type": "integer"
            },
            "metadata": {
              "additionalProperties": true,
              "title": "Metadata",
