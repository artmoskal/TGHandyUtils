          },
          "required": [
            "name",
            "model"
          ],
          "title": "ModelProfile",
          "type": "object"
        },
        "RetraceProvenance": {
          "additionalProperties": false,
          "description": "Typed retrace control state delivered to the retraced capability for ONE invocation.\n\nv0.10: the target learns it is being retraced as machine data \u2014 round, the evaluator\nnode, the rejected source node, and the retrace target \u2014 instead of inferring control\nstate from criticism prose. Retry/repair/replan do not produce this; only an actual\nretrace round does. The criticism rides as feedback, never as a control encoding.",
          "properties": {
            "criticism": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CriticismEnvelope"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "evaluator_node": {
              "title": "Evaluator Node",
              "type": "string"
            },
            "round": {
              "minimum": 1,
              "title": "Round",
              "type": "integer"
            },
            "source_node": {
              "title": "Source Node",
              "type": "string"
            },
            "target_node": {
              "title": "Target Node",
              "type": "string"
            }
          },
          "required": [
            "round",
            "evaluator_node",
            "source_node",
            "target_node"
          ],
          "title": "RetraceProvenance",
          "type": "object"
        },
        "RuntimeLimits": {
          "additionalProperties": false,
          "description": "Per-run limits that bound loops, tool calls, and paid work.\n\nThe ONE budget source (v0.9 clean contract): ceilings configured here enforce\nunconditionally. ``0`` is an honest hard-zero cap; \"no cap\" = leave the field None.\nUnknown keys are rejected \u2014 a typo'd ceiling must never silently mean \"unlimited\".",
          "properties": {
            "max_authored_fanout_items": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Max Authored Fanout Items",
              "type": "integer"
            },
            "max_estimated_usd": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Estimated Usd"
            },
            "max_estimated_usd_per_call": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Estimated Usd Per Call"
            },
            "max_image_calls": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Image Calls"
            },
            "max_images_per_call": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Images Per Call"
            },
            "max_input_tokens_per_call": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Input Tokens Per Call"
            },
            "max_output_tokens_per_call": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Output Tokens Per Call"
            },
            "max_parallel_children": {
              "default": 4,
              "minimum": 1,
              "title": "Max Parallel Children",
              "type": "integer"
            },
            "max_retrace": {
              "default": 1,
              "title": "Max Retrace",
              "type": "integer"
            },
            "max_retries": {
              "default": 1,
              "title": "Max Retries",
              "type": "integer"
            },
            "max_steps": {
              "default": 32,
              "title": "Max Steps",
              "type": "integer"
            },
            "max_text_calls": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Text Calls"
            },
            "max_worker_calls": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Worker Calls"
            },
            "timeout_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Timeout S"
            }
          },
          "title": "RuntimeLimits",
          "type": "object"
        },
        "RuntimePlan": {
          "description": "Inspectable product-neutral plan produced from a profile and trigger.",
